---
import { Icon } from 'astro-icon/components'
---
<div class="decofooter-container">
	<img src="/d/hr_fancy.png" alt="" class="decofooter l">
<img src="/d/hr_fancy.png" alt="" class="decofooter r">
</div>
<footer id="footer" class="footer">
	<div class="container">
		<div class="logo">
			<img src="/g/main-logo.png" alt="Main Logo	" class="main-logo">
		</div>
		<div class="navigations">
			<div class="navline">
				<h2 class="nav-head">NAVIGATE</h2>
				<div class="nav-list">
					<a href="/">Home</a>
					<a href="/highlights">Year Highlights</a>
					<a href="/rules">Rules & Committee</a>
				</div>
			</div>
			<div class="navline">
				<h2 class="nav-head">Other Links</h2>
				<div class="nav-list">
						<a href="https://www.nikulaswraith.com" target="_blank">Nikulas Wraith Website</a>
					<a href="https://vpe.digital" target="_blank">Virtual Phantom Entertainment</a>
				</div>
			</div>
		</div>
		<div class="end">
			<div class="links">
				<a href="https://twitter.com/PhantomBall" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:discord" />
				</a>
				<a href="https://discord.gg/phantomball" target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:twitter" />
				</a>
			</div>
			<p>The Phantom Ball of Auld Lang Syne is a celebratory gathering of friends and mutuals who enjoy gaming and bringing communities together.</p>
		</div>
	</div>
</footer>

<style lang="scss">
	.decofooter-container{
		position: relative;
		width: 100%;
		height: 80px;
		user-select: none;
		pointer-events: none;
	}
	.decofooter{
		position: absolute;
		top:-60px;
		height: 80px;
		object-fit: cover;
		z-index: -10;

		&.l{
			left: -120px;
			rotate: 35deg;
		}
		&.r{
			right: -120px;
			rotate: -35deg;
			transform: scaleX(-1);
		}
	}
	.footer {
		background: linear-gradient(to bottom, #0B2642, #081420);
		border-top: 10px solid #BC965C;
		border-bottom: 10px solid #BC965C;
		padding: 2em 0;
		outline: 2px solid #BC965C;
		position: relative;
		&::before{
			content:'';
			position:absolute;
			top:0%;
			left:0%;
			width:100%;
			height:100%;
			outline: #BC965C 3px solid;
			outline-offset: -20px;
			user-select: none;
			pointer-events: none;
			mask-image: linear-gradient(to right,  transparent 5%,  white 55%,  transparent 95%);
		}

		.logo{
			.main-logo{
				margin-top: -20%;
				z-index: 10;
			}
		}
		.navigations{
			display: grid;
			grid-template-columns: 1fr 1fr;
			padding-bottom: 2em;
			.nav-head{
				font-size: 2rem;
				color: #BC965C;
				text-decoration: underline;
			}
			.nav-list{
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				a{
					color: white;
					text-decoration: none;
					&:hover{
						color: #BC965C;
					}
				}
			}
		}

		.end{
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			p{
							text-align: right;
					color: white;
					font-size: 0.8rem;
			}
			.links{
				display: flex;
				gap: 1rem;
				margin-bottom: 1rem;
				a{
					color: white;
					font-size: 1.2rem;
					background: #081420;
					padding: .5em;
					border-radius: 10%;
					svg{
						width: 100%;
						height: 100%;
					}
					&:hover{
						color: #BC965C;
					}
		
				}
			}
		}
		.container{
			max-width: 1440px;
			margin: 0 auto;
			display: grid;
			gap: 2em;
			grid-template-columns: 1.2fr 1.8fr 1fr;
		}
	}
</style>